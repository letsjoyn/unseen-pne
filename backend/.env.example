# --- App ---
APP_ENV=local
APP_NAME=unseen-pne-api
LOG_LEVEL=INFO

# --- Database ---
# Local sqlite (default for hackathon dev):
DATABASE_URL=sqlite:///./data/local/unseen.db
# Or Postgres (docker-compose / Cloud SQL):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/unseen

# --- Auth ---
# Service-level token used by internal scripts and the /run pipeline endpoint.
API_AUTH_TOKEN=change-me-in-prod
# Real user JWTs (bcrypt + PyJWT). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-secret-change-in-prod-please-rotate-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# --- Google AI (Gemini) ---
# Use either GOOGLE_API_KEY (AI Studio) or Vertex AI service account.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# --- Models ---
GEMINI_MODEL_REASONING=gemini-2.0-flash-001
GEMINI_MODEL_DRAFTING=gemini-2.0-flash-001
GEMINI_MODEL_EMBEDDING=text-embedding-004

# --- Config seed paths (loaded on startup if DB empty) ---
CONFIG_DIR=./config
SEED_ON_START=true

# --- Integrations (optional; safe stubs by default) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=unseen@example.org

# WhatsApp (Twilio sandbox or Meta cloud); leave blank to use stub
WHATSAPP_PROVIDER=stub
WHATSAPP_API_KEY=
WHATSAPP_FROM=

# Google Maps / Places (optional; leave blank to use config-driven local fallback)
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_RADIUS_METERS=2000
GOOGLE_PLACES_KEYWORD=internet cafe|xerox|print shop|stationery

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
